{
  "name": "dsh-filesnap",
  "version": "0.1.0",
  "description": "Rewind and redo for DeepSeek Harness: put the workspace and the conversation back to the start of an earlier turn, without a repository and without touching your version control.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "filesnap",
    "rewind",
    "undo",
    "snapshot",
    "checkpoint"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:standalone": "vitest run tests/ids.spec.ts tests/config.spec.ts tests/cli.spec.ts tests/points.spec.ts",
    "harness:link": "node scripts/link-harness.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-fs": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-session-projection": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extracurricular-ai/file-snap-plugin.git"
  },
  "homepage": "https://github.com/extracurricular-ai/file-snap-plugin#readme",
  "bugs": {
    "url": "https://github.com/extracurricular-ai/file-snap-plugin/issues"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
